# ---------------------------------------------------------------------------
# Portal do Cliente — variáveis de ambiente
# Copie para .env.local (nunca faça commit do .env.local — já está no .gitignore)
# ---------------------------------------------------------------------------

# URL da Anfitrião API (FastAPI), incluindo o prefixo /api/v1.
# O portal chama a API SÓ pelo servidor do Next.js — o navegador nunca fala com ela.
API_URL=http://localhost:8000/api/v1

# Segredo compartilhado com a API (mesmo valor de PORTAL_PROXY_SECRET no .env da API).
# Com ele, a API aceita o IP do usuário final informado pelo portal (rate limit e
# auditoria por usuário, e não pelo IP do servidor do portal). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obrigatório em produção (a API exige ≥ 32 caracteres).
PORTAL_PROXY_SECRET=

# URL pública do portal. Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tempo máximo de cada chamada à API (ms).
# API_TIMEOUT_MS=15000

# Login, cadastro, senha, NFS-e (Focus NFe) e Firebase agora são configurados
# na API (veja anfitriao_api/.env.example e docs/INTEGRACAO_PORTAL.md).
