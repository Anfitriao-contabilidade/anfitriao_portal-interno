# Preencha com os valores do seu projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-aqui-a-anon-key

# --- Emissão de NFS-e (Focus NFe) — ver README, seção "Emissão de NFS-e" ---
# Token gerado no cadastro da empresa no painel do Focus NFe (um token por
# empresa/CNPJ cadastrado lá). Comece pelo token de homologação para testar.
FOCUSNFE_TOKEN=
# https://homologacao.focusnfe.com.br (testes) ou https://api.focusnfe.com.br (produção)
FOCUSNFE_BASE_URL=https://homologacao.focusnfe.com.br

# Dados da própria Anfitrião como prestadora — usados só nas notas do tipo
# "honorários" (Anfitrião cobrando o cliente), não nas notas de hospedagem
# (essas usam o CNPJ do próprio cliente, já cadastrado em profiles.documento).
ANFITRIAO_CNPJ=
ANFITRIAO_RAZAO_SOCIAL=
ANFITRIAO_INSCRICAO_MUNICIPAL=
